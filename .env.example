# Database connection (used by the app via adapter)
DATABASE_HOST=db
DATABASE_USER=killbill
DATABASE_PASSWORD=change_me_password
DATABASE_NAME=killbill
DATABASE_PORT=3306

# Prisma CLI uses this for migrations (constructed from above)
DATABASE_URL="mysql://killbill:change_me_password@db:3306/killbill"

# Docker Compose MySQL container (only needed if using docker-compose)
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_PASSWORD=change_me_password

# JWT Secret for Session Signing
JWT_SECRET=change_me_secret

# Gemini API Key for OCR (get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Feature flag: ephemeral spaces + guest (no-account) access (Fase 3).
# Off by default; set to "true" to enable guest invite links, guest claim,
# guest sessions and the guest→account upgrade.
EPHEMERAL_SPACES_ENABLED=false

# Fase 5 — Purga de espacios archivados (OPCIONAL). POST /api/cron/purge borra
# los espacios EPHEMERAL ARCHIVED más antiguos que PURGE_ARCHIVED_AFTER_DAYS.
# Protegido por el header `x-cron-secret` == CRON_SECRET. Si CRON_SECRET no está
# definida, el endpoint responde 503 (deshabilitado). En v1 NO hay scheduler:
# la retención por defecto es "recuerdo del viaje" indefinido, así que estas
# variables se dejan sin definir y el endpoint queda inactivo.
# CRON_SECRET=
# PURGE_ARCHIVED_AFTER_DAYS=90
