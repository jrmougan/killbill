# `mise run setup` generates unique ports, a Compose project name and secrets.
# For manual setup, choose unused ports and a unique name per worktree.
PORT=3000
COMPOSE_PROJECT_NAME=killbill-local

# Database connection (app runs on the host, MySQL runs in compose.dev.yaml)
DATABASE_HOST=127.0.0.1
DATABASE_USER=killbill
DATABASE_PASSWORD=change_me_password
DATABASE_NAME=killbill
DATABASE_PORT=13306

# Prisma CLI uses this for migrations (constructed from above)
DATABASE_URL="mysql://killbill:change_me_password@127.0.0.1:13306/killbill"

# Local MySQL root account; the app uses DATABASE_USER/DATABASE_PASSWORD.
MYSQL_ROOT_PASSWORD=change_me_root_password

# JWT Secret for Session Signing
JWT_SECRET=change_me_secret

# Gemini API Key for OCR (get from https://aistudio.google.com)
GEMINI_API_KEY=

# Optional OCR fallback through OpenRouter. Used when Gemini fails or returns an
# invalid response. The model can be overridden without changing application code.
OPENROUTER_API_KEY=
OPENROUTER_OCR_MODEL=xiaomi/mimo-v2.6-flash

# Directory for uploaded receipts/avatars (absolute or relative to the cwd).
# Must NOT be under public/ (Next would serve it statically, without a session).
# Default: <cwd>/uploads (the Docker image sets /app/uploads).
# UPLOAD_DIR=

# Feature flag: ephemeral spaces + guest (no-account) access (Fase 3).
# Off by default; set to "true" to enable guest invite links, guest claim,
# guest sessions and the guest→account upgrade.
EPHEMERAL_SPACES_ENABLED=false

# Fase 5 — Purga de espacios archivados (OPCIONAL). POST /api/cron/purge borra
# los espacios EPHEMERAL ARCHIVED más antiguos que PURGE_ARCHIVED_AFTER_DAYS.
# Protegido por el header `x-cron-secret` == CRON_SECRET. Si CRON_SECRET no está
# definida, el endpoint responde 503 (deshabilitado). En v1 NO hay scheduler:
# la retención por defecto es "recuerdo del viaje" indefinido, así que estas
# variables se dejan sin definir y el endpoint queda inactivo.
# CRON_SECRET=
# PURGE_ARCHIVED_AFTER_DAYS=90

# MCP Server — token lifetime for external agent access (e.g. Hermes Agent).
# Tokens are issued by POST /api/me/mcp-token and used as Bearer credentials
# for the MCP endpoint at POST /api/mcp.
# MCP_TOKEN_TTL_DAYS=90
