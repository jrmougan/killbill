generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum RecurringInterval {
  weekly
  monthly
  yearly
}

// Espacios (Fase 0). El tipo de espacio determina la política (cap de miembros,
// budgets/recurrentes permitidos, invitados). INDIVIDUAL queda RESERVADO (modo
// virtual permanente, sin filas Couple ni migración de gastos personales).
enum SpaceType {
  INDIVIDUAL
  COUPLE
  GROUP
  EPHEMERAL
}

// Ciclo de vida de un espacio: ACTIVE (escribible) → SETTLING (saldando) →
// ARCHIVED (solo lectura, recuerdo indefinido). Los efímeros archivados no se
// auto-purgan en v1.
enum SpaceStatus {
  ACTIVE
  SETTLING
  ARCHIVED
}

// Fase 0: clase de invitación por enlace. MEMBER invita a registrados; GUEST
// crea un User sombra (solo EPHEMERAL activo).
enum InviteKind {
  MEMBER
  GUEST
}

enum SettlementStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum SettlementMethod {
  CASH
  BIZUM
  TRANSFER
}

enum ExpenseVisibility {
  PERSONAL
  SHARED
}

// How an expense's Split rows were derived. Persisted so an expense can be
// re-edited/audited without re-guessing intent. Null for PERSONAL expenses
// (never split) and legacy rows not yet backfilled.
enum SplitStrategy {
  EQUAL     // divided evenly among ACTIVE members
  CUSTOM    // explicit per-user amounts supplied by the client
  EXCLUSIVE // 100% charged to a single beneficiary
  ITEMIZED  // derived from receipt line items (common part split + exclusive items)
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  GUEST // Fase 0: invitado sombra (EPHEMERAL). AL FINAL del enum: metadata-only en MySQL 8, no reordenar.
}

// Phase 2e: semantics of a Budget's period so a MONTH budget and a CUSTOM budget
// covering the same range stay distinguishable. Every legacy budget is a month.
enum BudgetPeriodType {
  MONTH
  WEEK
  YEAR
  CUSTOM
}

// Phase 3: kind of economic event a LedgerTransaction records.
enum LedgerTxnKind {
  EXPENSE
  SETTLEMENT
}

enum MembershipStatus {
  ACTIVE
  LEFT
  REMOVED
}

model Couple {
  id        String    @id @default(cuid())
  name      String?
  code      String    @unique // For invites
  createdAt DateTime  @default(now())

  // Espacios (Fase 0). Aditivo con DEFAULT — el código actual las ignora. El
  // backfill de `type` (GROUP donde ACTIVE members > 2) va en un script manual
  // verificable, NO en el SQL de la migración.
  type       SpaceType   @default(COUPLE)
  status     SpaceStatus @default(ACTIVE)
  archivedAt DateTime?
  expiresAt  DateTime? // solo EPHEMERAL: sugerencia de cierre, sin cron en v1
  createdById String?
  createdBy   User?   @relation("SpaceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  memberships Membership[]
  expenses    Expense[]
  settlements Settlement[]
  tags        Tag[]
  budgets     Budget[]
  categories  Category[]
  recurringSeries RecurringSeries[]
  accounts           Account[]
  ledgerTransactions LedgerTransaction[]
  groupInvites       GroupInvite[]
  shoppingLists      ShoppingList[]

  @@index([status, expiresAt])
}

// Fase 0: invitación por enlace a un espacio. El token en claro NO se guarda,
// solo su sha256 (`tokenHash`) + un prefijo para listarlo en la UI. Canje
// transaccional con updateMany condicional (patrón anti-carrera de InviteCode).
model GroupInvite {
  id          String     @id @default(cuid())
  groupId     String
  group       Couple     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tokenHash   String     @unique
  tokenPrefix String
  kind        InviteKind
  maxUses     Int
  usedCount   Int        @default(0)
  expiresAt   DateTime // OBLIGATORIO
  revokedAt   DateTime?
  createdById String
  createdBy   User       @relation("GroupInviteCreator", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())

  @@index([groupId])
  @@index([createdById])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  pin       String?
  avatar    String?
  password  String?
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  // Fase 0: identidad de invitado sombra (EPHEMERAL). isGuest=true → email/
  // password NULL; el upgrade a cuenta real es un UPDATE de la misma fila.
  isGuest    Boolean   @default(false)
  upgradedAt DateTime?

  // Phase 5 contract: User.coupleId dropped — Membership is the sole membership
  // source (getPrimaryGroup / getGroupMembers).
  memberships Membership[]

  expensesPaid  Expense[] @relation("Payer")
  expensesOwned Expense[] @relation("Owner")
  splits        Split[]
  receiptLines  ReceiptLineItem[] @relation("ReceiptLineAssignee")

  recurringSeriesOwned RecurringSeries[] @relation("RecurringSeriesOwner")
  recurringSeriesPaid  RecurringSeries[] @relation("RecurringSeriesPayer")

  accounts Account[]

  settlementsPaid     Settlement[] @relation("SettlementPayer")
  settlementsReceived Settlement[] @relation("SettlementReceiver")

  personalBudgets Budget[] @relation("PersonalBudget")

  inviteCodesCreated InviteCode[] @relation("InviteCreator")
  inviteCodeUsed     InviteCode?  @relation("InviteUser")

  // Espacios (Fase 0): auditoría de quién creó el espacio (onDelete SetNull).
  spacesCreated Couple[] @relation("SpaceCreator")

  // Fase 0: enlaces de invitación creados por este usuario.
  groupInvitesCreated GroupInvite[] @relation("GroupInviteCreator")

  // Fase 0: gastos creados por este usuario (autoría; backfill COALESCE(ownerId, paidById)).
  expensesCreated Expense[] @relation("ExpenseCreator")

  // Fase 0: tags personales (XOR con coupleId por convención, patrón Budget).
  personalTags Tag[] @relation("PersonalTag")

  // Categorías personales (modo INDIVIDUAL): XOR con groupId, patrón Tag/Budget.
  personalCategories Category[] @relation("PersonalCategory")

  // Listas de la compra: personales (ownerId), creadas por (createdById) e items
  // marcados como comprados por este usuario (checkedById). Auditoría con SetNull;
  // Cascade solo en personales (borrar usuario arrastra sus listas personales).
  personalShoppingLists ShoppingList[]     @relation("PersonalShoppingList")
  createdShoppingLists  ShoppingList[]     @relation("ShoppingListCreator")
  checkedShoppingItems  ShoppingListItem[] @relation("ShoppingItemChecker")
}

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  expiresAt DateTime?
  
  // Who created this invite
  createdById String
  createdBy   User   @relation("InviteCreator", fields: [createdById], references: [id])
  
  // Who used this invite (null if unused)
  usedById String? @unique
  usedBy   User?   @relation("InviteUser", fields: [usedById], references: [id])
}

// Many-to-many membership layer added in Phase 1 alongside the one-user-one-couple
// model. groupId == Couple.id for now (FK to Couple until the Phase 2 rename to Group).
model Membership {
  id       String @id @default(cuid())

  groupId  String
  group    Couple @relation(fields: [groupId], references: [id], onDelete: Cascade)

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role     MembershipRole   @default(MEMBER)
  status   MembershipStatus @default(ACTIVE)

  // Fase 0: enlace personal de recuperación multi-dispositivo del invitado
  // (rotable). NULLs múltiples permitidos en MySQL bajo índice único.
  guestTokenHash String? @unique

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([groupId, status])
}

// Category metadata + membership, replacing the fixed ExpenseCategory enum.
// System categories have groupId = null (global, available to everyone incl.
// personal expenses); a set groupId makes it a group-custom category. Icons are
// stored as a lucide component name (mapped to a component in categories.ts).
model Category {
  id        String  @id @default(cuid())
  key       String  // stable slug; matches ExpenseCategory for system rows
  label     String
  labelEn   String
  emoji     String
  icon      String  // lucide-react component name
  color     String  // tailwind text-* class (system rows)
  bgColor   String  // tailwind bg-* class (system rows)
  hex       String
  sortOrder Int     @default(0)
  isSystem  Boolean @default(false)

  groupId String?
  group   Couple? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Categorías personales (modo INDIVIDUAL, sin fila Couple): XOR con groupId por
  // convención, patrón Tag/Budget. ownerId set → categoría personal del usuario.
  ownerId String?
  owner   User?   @relation("PersonalCategory", fields: [ownerId], references: [id], onDelete: Cascade)

  expenses Expense[]
  budgets  Budget[]
  recurringSeries RecurringSeries[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, key])
  @@unique([ownerId, key])
  @@index([groupId])
  @@index([ownerId])
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Int
  date        DateTime @default(now())
  // Relational category (Phase 2b) — the sole category source after the Phase 5
  // contract dropped the ExpenseCategory enum column.
  categoryId  String?
  categoryRef Category? @relation(fields: [categoryId], references: [id])

  receiptUrl  String?

  visibility  ExpenseVisibility @default(SHARED)

  // How `splits` were derived (see SplitStrategy). Nullable: PERSONAL expenses
  // have no splits, and pre-Phase-2 rows are backfilled best-effort.
  splitStrategy SplitStrategy?

  notes String?

  // Bank CSV import (Phase "decouple" F2): content fingerprint of an imported
  // row (sha256 of ownerId|date|amountCents|description) — unique so re-importing
  // the same statement never duplicates. NULL for manually-created expenses.
  importFingerprint String? @unique

  paidById String
  // Fase 4: Restrict (no Cascade) desde User — borrar un User con gastos que pagó
  // destruiría la contabilidad del grupo. Baja = REMOVED/anonimizar, nunca DELETE.
  paidBy   User   @relation("Payer", fields: [paidById], references: [id], onDelete: Restrict)

  // Fase 0: autoría del gasto (quién lo creó). Imprescindible para que un GUEST
  // solo pueda editar/borrar los suyos. Nullable + SetNull; backfill
  // COALESCE(ownerId, paidById) en el SQL de la migración.
  createdById String?
  createdBy   User?   @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Owner of the "book" this expense belongs to (always set). For shared
  // expenses this defaults to the creator; for personal expenses it is the
  // only user who can see it.
  ownerId String
  // Fase 4: Restrict (no Cascade) desde User — mismo motivo que paidBy.
  owner   User   @relation("Owner", fields: [ownerId], references: [id], onDelete: Restrict)

  // Personal expenses have no couple; shared ones are scoped to a Couple.
  coupleId String?
  couple   Couple? @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  splits      Split[]
  tags        ExpenseTag[]
  lineItems   ReceiptLineItem[]
  ledgerTransactions LedgerTransaction[]

  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])

  // Phase 2d: link generated instances (and the original template) to their
  // recurring series. Nullable + dual-written; recurrence source of truth stays
  // on the Expense.* fields above this phase.
  seriesId String?
  series   RecurringSeries? @relation("SeriesInstances", fields: [seriesId], references: [id], onDelete: SetNull)

  // Phase 5 (stop-dual-write): the durable pointer from a series to its TEMPLATE
  // expense, replacing the isRecurring discriminator the materializer used to key on.
  templateForSeries RecurringSeries? @relation("SeriesTemplate")

  currency  String   @default("EUR")
  minorUnit Int      @default(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coupleId])
  @@index([paidById])
  @@index([ownerId])
  @@index([ownerId, visibility])
  @@index([categoryId])
  @@index([seriesId])
  @@index([createdById])
}

// Relational receipt line items (Phase 2c), replacing the Expense.receiptData
// JSON blob. Money is stored in integer cents here — unlike the legacy JSON,
// which stored euro floats — bringing receipts in line with the rest of the app.
// Dual-written alongside receiptData until the read-switch/contract step.
model ReceiptLineItem {
  id          String @id @default(cuid())

  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  description String
  quantity    Float @default(1) // may be fractional (weighed goods)
  unitPrice   Int   // unit price in cents
  lineTotal   Int   // line total in cents (can be negative, e.g. promotions)
  position    Int   @default(0) // preserves receipt order

  // Exclusive assignment: the user this line is charged 100% to (null = shared).
  assignedToId String?
  assignedTo   User?   @relation("ReceiptLineAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expenseId])
  @@index([assignedToId])
}

// Phase 2d: the recurring RULE/TEMPLATE, separated from the generated instances.
// Recurrence currently lives on Expense (isRecurring/recurringInterval/
// nextRecurringDate), which conflates template and instance. This model holds the
// rule + template values; generated instances (and the original template) point
// back via Expense.seriesId. Additive + dual-written — the Expense.* recurrence
// fields stay the source of truth this phase (read-switch deferred).
model RecurringSeries {
  id          String @id @default(cuid())

  description String
  amount      Int

  categoryId  String?
  categoryRef Category? @relation(fields: [categoryId], references: [id])

  visibility    ExpenseVisibility @default(SHARED)
  splitStrategy SplitStrategy?
  notes         String?

  interval    RecurringInterval
  nextRunDate DateTime

  // Phase 4 (recurring-sync): deactivation instead of deletion — deleting a
  // series would SetNull instance.seriesId (losing lineage). isActive=false
  // stops materialization; toggling the template recurring back ON re-activates.
  isActive Boolean @default(true)

  coupleId String?
  couple   Couple? @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation("RecurringSeriesOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  paidById String
  paidBy   User   @relation("RecurringSeriesPayer", fields: [paidById], references: [id], onDelete: Cascade)

  currency  String @default("EUR")
  minorUnit Int    @default(2)

  // Materialized instances of this series (Expense.seriesId back-relation).
  expenses Expense[] @relation("SeriesInstances")

  // Phase 5 (stop-dual-write): durable pointer to the TEMPLATE expense. The
  // materializer copies money scalars + splits/tags from it; identifying the
  // template no longer needs Expense.isRecurring. Nullable+unique (one template
  // per series); FK SetNull so deleting the template clears the pointer.
  templateId String?  @unique
  template   Expense? @relation("SeriesTemplate", fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coupleId])
  @@index([ownerId])
  @@index([paidById])
  @@index([categoryId])
  @@index([nextRunDate])
  @@index([isActive, nextRunDate])
}

model Split {
  id     String @id @default(cuid())
  amount Int

  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([expenseId, userId])
  @@index([expenseId])
  @@index([userId])
}

model Settlement {
  id   String   @id @default(cuid())
  date DateTime @default(now())

  // Who is settling their debt (The Debtor)
  fromUserId String
  // Fase 4: Restrict (no Cascade) desde User — borrar un User con liquidaciones
  // rompería el zero-sum de la contabilidad. Baja = REMOVED/anonimizar.
  fromUser   User   @relation("SettlementPayer", fields: [fromUserId], references: [id], onDelete: Restrict)

  // Who is receiving the settlement (The Creditor)
  toUserId String
  toUser   User   @relation("SettlementReceiver", fields: [toUserId], references: [id], onDelete: Restrict)

  coupleId String
  couple   Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  amount Int // Total amount in CENTS
  status SettlementStatus @default(PENDING)
  method SettlementMethod @default(CASH)

  currency  String   @default("EUR")
  minorUnit Int      @default(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]
  ledgerTransactions LedgerTransaction[]

  @@index([coupleId])
  @@index([fromUserId])
  @@index([toUserId])
}

model Tag {
  id       String @id @default(cuid())
  name     String
  color    String @default("#8b5cf6")

  // Fase 0: un Tag es de grupo (coupleId set) o personal (ownerId set) — XOR por
  // convención, patrón Budget. coupleId pasa a nullable para admitir tags
  // personales; los tags existentes conservan su coupleId.
  coupleId String?
  couple   Couple? @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation("PersonalTag", fields: [ownerId], references: [id], onDelete: Cascade)

  expenses ExpenseTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, coupleId])
  @@index([coupleId])
  @@index([ownerId])
}

model ExpenseTag {
  expenseId String
  tagId     String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([expenseId, tagId])
}

// Phase 3: double-entry ledger — an auditable shadow of finance.ts. Every economic
// event that moves a group balance becomes ONE balanced LedgerTransaction whose
// per-member LedgerEntry rows are net deltas summing to zero. A member's running
// entry-sum reproduces calculateBalances[member] exactly (integer cents). finance.ts
// stays the sole source of truth this phase (read-switch deferred).
model Account {
  id        String   @id @default(cuid())

  groupId   String
  group     Couple   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  userId    String
  // Fase 4: Restrict (no Cascade) desde User — red de seguridad del ledger.
  // LedgerEntry cuelga de Account (no de User), así que restringir aquí impide
  // borrar un User con actividad de ledger sin tocar LedgerEntry.
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  entries   LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model LedgerTransaction {
  id           String        @id @default(cuid())

  groupId      String
  group        Couple        @relation(fields: [groupId], references: [id], onDelete: Cascade)

  kind         LedgerTxnKind

  // Idempotency key: 'expense:<id>' | 'settlement:<id>:confirm'. Backfill and
  // dual-write upsert on it, so events self-heal instead of double-posting.
  dedupeKey    String        @unique

  amount       Int           // gross magnitude in cents (audit/display only)
  postedAt     DateTime      // economic date (expense.date / settlement.date)

  expenseId    String?
  expense      Expense?      @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  settlementId String?
  settlement   Settlement?   @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  entries      LedgerEntry[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([groupId, kind])
  @@index([expenseId])
  @@index([settlementId])
}

model LedgerEntry {
  id            String            @id @default(cuid())

  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  accountId     String
  account       Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)

  amount        Int               // signed cents: + = member is owed, - = member owes

  createdAt     DateTime          @default(now())

  @@unique([transactionId, accountId])
  @@index([transactionId])
  @@index([accountId])
}

model Budget {
  id       String          @id @default(cuid())
  // Phase 5 contract: the legacy enum `category` and `month` columns were dropped.
  // The category+period source of truth is categoryId + periodStart/periodEnd.
  amount   Int             // limite en centavos

  // Phase 2e: explicit half-open [periodStart, periodEnd) range. periodStart is
  // now NOT NULL — a key part of the categoryId+periodStart uniques.
  periodStart DateTime
  periodEnd   DateTime?
  periodType  BudgetPeriodType @default(MONTH)

  // Relational category (Phase 2b) — now the sole category source (NOT NULL).
  categoryId  String
  categoryRef Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // A budget is either shared (coupleId set) or personal (ownerId set).
  coupleId String?
  couple   Couple? @relation(fields: [coupleId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation("PersonalBudget", fields: [ownerId], references: [id], onDelete: Cascade)

  currency  String   @default("EUR")
  minorUnit Int      @default(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, periodStart, coupleId])
  @@unique([categoryId, periodStart, ownerId])
  @@index([coupleId])
  @@index([ownerId])
  @@index([categoryId])
  @@index([periodStart])
}

// Lista de la compra. XOR grupo/personal (patrón Category/Tag): una lista es de
// grupo (groupId set) o personal (ownerId set). Ambos nullable para admitir
// listas personales sin migración destructiva. SIN @@unique en name: duplicados
// ('Mercadona' x2) son legítimos y evitan P2002 en alta concurrente.
model ShoppingList {
  id          String  @id @default(cuid())
  name        String
  description String? // nota opcional a nivel de lista
  sortOrder   Int     @default(0)

  groupId String?
  group   Couple? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation("PersonalShoppingList", fields: [ownerId], references: [id], onDelete: Cascade)

  // Auditoría (patrón createdBy/SetNull); la baja de usuario nunca borra la lista.
  createdById String?
  createdBy   User?   @relation("ShoppingListCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ShoppingListItem[]

  @@index([groupId])
  @@index([ownerId])
}

// Item de una lista de la compra. Herramienta de PLANIFICACIÓN de la compra
// física (el gasto lo contabiliza el OCR del ticket, no la lista). SIN @@unique en
// (listId,name): permite añadir el mismo producto dos veces y evita P2002 en alta
// paralela. `aisle` es una categoría OPCIONAL por PASILLO del súper (auto-asignada
// por nombre), ortogonal a las categorías de gasto: organiza el recorrido físico.
model ShoppingListItem {
  id     String       @id @default(cuid())
  listId String
  list   ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  name       String
  quantity   Int?    // opcional
  unit       String? // libre en v1 (ud/kg/g/L/pack); no enum todavía
  note       String? // nota opcional a nivel de item
  aisle      String? // clave de pasillo del súper (vocabulario en src/lib/aisles.ts); nullable, auto-asignada

  checked     Boolean   @default(false)
  checkedById String?
  checkedBy   User?     @relation("ShoppingItemChecker", fields: [checkedById], references: [id], onDelete: SetNull)
  checkedAt   DateTime?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listId])
  @@index([checkedById])
}
